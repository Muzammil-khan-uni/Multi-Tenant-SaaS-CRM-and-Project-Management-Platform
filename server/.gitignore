# ────────────────────────────────
# server/.gitignore  (Node.js / Express API)
# ────────────────────────────────

# Dependencies
node_modules/
.pnp
.pnp.js

# Environment variables — NEVER commit real secrets
.env
.env.local
.env.development
.env.development.local
.env.test
.env.test.local
.env.production
.env.production.local
!.env.example

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Runtime data
pids/
*.pid
*.seed
*.pid.lock

# Coverage / testing
coverage/
.nyc_output/

# Uploaded / generated files (if stored locally before Cloudinary push)
uploads/
tmp/
temp/

# Generated PDFs (invoices/reports), if written to disk before upload/send
generated/
*.pdf.tmp

# Build output
dist/
build/

# Editor / IDE
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db

# Misc
*.tgz
*.tsbuildinfo
